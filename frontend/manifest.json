{
  "manifest_version": 3,
  "name": "Tutorial Generator - Recorder",
  "version": "1.0.0",
  "description": "Grava ações do usuário e gera tutoriais com suporte a Chrome, Edge e Firefox",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tutorial Generator"
  },
  "permissions": [
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tutorial-generator@homolog2.local"
    }
  },
  "host_permissions": []
}
